{
  "name": "relancepro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RelancePro — gestion commerciale pour petites entreprises",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "db:check": "npm run db:check --workspace server",
    "db:migrate": "npm run db:migrate --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
